# 第一位完成註冊且 Email 完全相同的使用者會成為管理員。
INITIAL_ADMIN_EMAIL=you@example.com

# 至少 32 個隨機字元。請分別使用不同值。
AUTH_PEPPER=replace-with-a-long-random-secret
KEY_ENCRYPTION_SECRET=replace-with-another-long-random-secret

# 驗證信供應商：brevo（免費方案）、gmail 或 resend。
EMAIL_PROVIDER=brevo

# Brevo 免費方案可用於交易型驗證信。API Key 請只設在託管環境的 Secret。
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CatGPT

# 改用 Gmail API 時設定以下四項，並將 EMAIL_PROVIDER 改為 gmail。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=

# 改用 Resend 時設定以下兩項，並將 EMAIL_PROVIDER 改為 resend。
RESEND_API_KEY=
EMAIL_FROM=CatGPT <noreply@example.com>

# 只供本機開發；正式環境不可啟用。
AUTH_DEV_MODE=false
AUTH_DEV_VERIFICATION_CODE=123456
